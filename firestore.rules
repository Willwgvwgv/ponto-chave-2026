rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userStatus() {
      return getUserData().status;
    }

    function userRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        userRole() == 'superadmin' ||
        request.auth.token.email == 'williangyn10@gmail.com'
      );
    }

    function isDeletedUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/deleted_users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && !isDeletedUser() && (
        isSuperAdmin() || (
          userRole() != 'none' && userRole() != '' && userRole() != null &&
          (userStatus() == 'active' || userStatus() == 'APPROVED' || userStatus() == 'APPROVED_BY_ADMIN')
        )
      );
    }

    function belongsToCompany(companyId) {
      return isActiveUser() && (
        isSuperAdmin() ||
        getUserData().companyId == companyId
      );
    }

    function isCompanyAdmin(companyId) {
      return isActiveUser() && (
        isSuperAdmin() || (
          getUserData().companyId == companyId &&
          (userRole() == 'admin' || userRole() == 'manager')
        )
      );
    }

    // Permissão de módulo marcada no cadastro do usuário (aba Permissões de Módulos).
    function hasModulePerm(modulo, campo, campoAntigo) {
      return modulo in getUserData().get('permissions', []) ||
        getUserData().get(campo, false) == true ||
        getUserData().get(campoAntigo, false) == true;
    }

    // Campos de permissão: só admin/gerente (ou superadmin) altera. O próprio
    // usuário pode editar o perfil (nome, WhatsApp), mas não se dar acesso.
    function permissionFields() {
      return ['permissions', 'permRateioLocacao', 'permRateioVendas',
        'permComissoes', 'perm_comissoes', 'permFinanceiro', 'perm_financeiro',
        'permVistorias', 'perm_vistorias', 'permProcessos', 'perm_processos',
        'permPonto', 'perm_ponto', 'permEnergia', 'perm_energia'];
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && !isDeletedUser() && (
          request.auth.uid == userId ||
          isCompanyAdmin(resource.data.companyId)
        )
      );
           // Duas situações de "list" além do "get" (get já é coberto pelo allow read acima):
      // 1) Qualquer colega ativo da mesma empresa pode listar a equipe (usado pra
      //    atribuir tarefas etc.) — a consulta já filtra por companyId no código.
      // 2) Localizar o(s) próprio(s) documento(s) por e-mail (usado no login, para
      //    achar um convite pendente antes da migração pro uid definitivo) — só
      //    enxerga documentos cujo e-mail bate com o do usuário autenticado.
      allow list: if isSuperAdmin() || (
        isSignedIn() && !isDeletedUser() && belongsToCompany(resource.data.companyId)
      ) || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
      allow create: if isSuperAdmin() || (
        isSignedIn() && isCompanyAdmin(request.resource.data.companyId)
      ) || (
        isSignedIn() && request.auth.uid == userId && request.resource.data.uid == userId &&
        request.resource.data.role != 'admin' && request.resource.data.role != 'superadmin' && request.resource.data.role != 'manager' &&
        request.resource.data.status != 'active' && request.resource.data.status != 'APPROVED' && request.resource.data.status != 'APPROVED_BY_ADMIN' &&
        !request.resource.data.keys().hasAny(permissionFields())
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() && !isDeletedUser() && (
          isCompanyAdmin(resource.data.companyId) || (
            request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.companyId == resource.data.companyId &&
            request.resource.data.uid == resource.data.uid &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(permissionFields())
          )
        )
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && !isDeletedUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: deleted_users (Tombstones)
    match /deleted_users/{docId} {
      allow read: if isSignedIn() && (
        request.auth.uid == docId ||
        isSuperAdmin() ||
        isCompanyAdmin(getUserData().companyId)
      );
      allow create, update: if isSuperAdmin() || (
        isSignedIn() && !isDeletedUser() && isCompanyAdmin(getUserData().companyId)
      );
      allow delete: if isSuperAdmin();
    }

    // Collection: invites
    match /invites/{inviteId} {
      // Leitura individual de token de convite necessária para pré-validação antes do login
      allow get: if true;
      // Listagem restrita a administradores da empresa ou SuperAdmin
      allow list: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(request.resource.data.companyId));
      allow update: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId)) || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
      );
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: companies
    match /companies/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && (getUserData().companyId == id || resource.data.id == getUserData().companyId));
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isCompanyAdmin(id);
      allow delete: if isSuperAdmin();
    }

    // Collection: tasks
    match /tasks/{taskId} {
      allow read: if isSuperAdmin() || (
        isActiveUser() && belongsToCompany(resource.data.companyId) && (
          isCompanyAdmin(resource.data.companyId) ||
          resource.data.createdBy == request.auth.uid ||
          resource.data.assignedToUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
      allow create: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow update: if isSuperAdmin() || (
        isActiveUser() && belongsToCompany(resource.data.companyId) && (
          isCompanyAdmin(resource.data.companyId) ||
          resource.data.createdBy == request.auth.uid ||
          resource.data.assignedToUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: comissoes
    match /comissoes/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(request.resource.data.companyId));
      allow update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: energia_locacoes (Acompanhamento de Energia)
    // Ver e cadastrar: admin/gerente da empresa ou quem tem a permissão "Energia".
    // Editar e excluir: só admin/gerente, sem trocar o registro de empresa.
    function canEnergia(companyId) {
      return belongsToCompany(companyId) &&
        (isCompanyAdmin(companyId) || hasModulePerm('energia', 'permEnergia', 'perm_energia'));
    }
    match /energia_locacoes/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && canEnergia(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && canEnergia(request.resource.data.companyId));
      allow update: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId);
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: sales
    match /sales/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: broker_splits
    match /broker_splits/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: broker_advances
    match /broker_advances/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: bank_accounts
    match /bank_accounts/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: financial_categories
    match /financial_categories/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: financial_transactions
    match /financial_transactions/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: vistorias
    match /vistorias/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: contratos_locacao
    match /contratos_locacao/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow update: if isSuperAdmin() || (
        isActiveUser() &&
        belongsToCompany(resource.data.companyId) &&
        belongsToCompany(request.resource.data.companyId)
      );
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: contratos_modelos
    match /contratos_modelos/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow update: if isSuperAdmin() || (
        isActiveUser() &&
        belongsToCompany(resource.data.companyId) &&
        belongsToCompany(request.resource.data.companyId)
      );
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: despejos
    match /despejos/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: propostas_bella_white
    match /propostas_bella_white/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && (
        resource.data.createdBy == request.auth.uid ||
        isCompanyAdmin(getUserData().companyId)
      ));
      allow create: if isSuperAdmin() || (isActiveUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin() || (isActiveUser() && (
        resource.data.createdBy == request.auth.uid ||
        isCompanyAdmin(getUserData().companyId)
      ));
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(getUserData().companyId));
    }

    // Collection: ponto_registros
    match /ponto_registros/{id} {
      // GET (um dia): dono pelo ID "{uid}_{data}" — funciona mesmo quando o registro
      // do dia ainda não existe (primeira batida), quando resource é null.
      allow get: if isSuperAdmin() || (isActiveUser() && (
        id.split('_')[0] == request.auth.uid ||
        isCompanyAdmin(getUserData().companyId)
      ));
      // LIST (espelho do mês): o Firestore só autoriza consultas com regra que ele
      // consiga provar pelos filtros da consulta (where userId == uid). Regra baseada
      // no ID do documento faz a consulta do mês ser recusada e o espelho fica vazio.
      allow list: if isSuperAdmin() || (isActiveUser() && (
        resource.data.userId == request.auth.uid ||
        isCompanyAdmin(getUserData().companyId)
      ));
      allow create: if isSuperAdmin() || (isActiveUser() &&
        request.resource.data.userId == request.auth.uid &&
        id.split('_')[0] == request.auth.uid);
      allow update: if isSuperAdmin() || (isActiveUser() && (
        ((id.split('_')[0] == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.userId == request.auth.uid) ||
        isCompanyAdmin(getUserData().companyId)
      ));
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(getUserData().companyId));
    }

    // Collection: ponto_ajustes
    match /ponto_ajustes/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isCompanyAdmin(getUserData().companyId)
      ));
      allow create: if isSuperAdmin() || (isActiveUser() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(getUserData().companyId));
    }

    // Collection: tools
    match /tools/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: processes
    match /processes/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update: if isSuperAdmin() || (isActiveUser() && belongsToCompany(request.resource.data.companyId));
      allow delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }

    // Collection: process_templates
    // Coleção compartilhada entre todas as empresas (os documentos não têm
    // companyId — nunca tiveram). Por isso a leitura é liberada a qualquer
    // usuário ativo, e a escrita a qualquer admin/gerente ativo, sem checar
    // companyId (que não existe nesses documentos).
    match /process_templates/{id} {
      allow read: if isSuperAdmin() || isActiveUser();
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && (userRole() == 'admin' || userRole() == 'manager'));
    }

    // Collection: settings
    match /settings/{id} {
      allow read: if isSuperAdmin() || (isActiveUser() && belongsToCompany(resource.data.companyId));
      allow create, update, delete: if isSuperAdmin() || (isActiveUser() && isCompanyAdmin(resource.data.companyId));
    }
  }
}
